# --------------------------------------------------------------------------- #
# MP1 additions
# --------------------------------------------------------------------------- #

# KiCad lock files, written while a board or schematic is open.
~*.lck

# LTspice text exports. Regenerated from the .raw, and analyze_vout.py reads
# the .raw directly, so there is no reason to carry a second copy of the same
# waveform as ASCII.
mp1_sim.txt

# Scratch directory for the LTspice runs tolerance_simulation.py drives. It is
# cleaned up as it goes, but a crashed run leaves chunks behind.
_sweep/

# Figures written by the simulation scripts. All of them regenerate in seconds
# (montecarlo_model takes 100k closed-form runs and is still instant), so they
# are outputs rather than sources. Delete these three lines if you would rather
# commit the exact figures that went into the report.
sweep*.png
montecarlo*.png
tolerance*.png
corners*.png

# The rule above for *.csv already covers candidates.csv and every
# *_results/_model table the scripts write.

# ...but NOT the simulation netlist. The *.net rule up in the KiCad section is
# aimed at Eeschema exports; mp1_sim.net is the file tolerance_simulation.py
# reads its nominal component values out of, so ignoring it would make the
# whole simulation unreproducible from a fresh clone.
!mp1_sim.net
